@@ -0,0 +1,27 @@
+package parsercorephase0
+
+import (
+	"math"
+	"testing"
+	"unsafe"
+)
+
+// Keep native field reads while fitting the complete action into 16 bytes.
+// No state, metadata or flag is narrowed or encoded.
+func TestNativeActionLayoutPreservesFullWidths(t *testing.T) {
+	if got := unsafe.Sizeof(Action{}); got != 16 {
+		t.Fatalf("action occupies %d bytes; want 16", got)
+	}
+	action := Action{Type: ActionType(255), State: math.MaxUint32, Symbol: math.MaxUint16, ChildCount: math.MaxUint8, DynamicPrecedence: math.MinInt16, ProductionID: math.MaxUint16, Extra: true, ExtraChain: true, Repetition: true}
+	input := []Action{action}
+	row := NewActionRow(input, true)
+	input[0] = Action{}
+	if row.At(0) != action || !row.Reusable() {
+		t.Fatal("snapshot did not preserve every field")
+	}
+	got := row.At(0)
+	got.State = 0
+	if row.At(0) != action {
+		t.Fatal("returned value changed immutable row")
+	}
+}

+// BenchmarkGoParseCompactFreshOneMiB measures the large-file allocation path
+// with a new parser for each file. The shared language tables are warm; the
+// record arrays are not. Its witness and work match the large locked-C gate.
+func BenchmarkGoParseCompactFreshOneMiB(b *testing.B) {
+	source, _, err := benchfixtures.GeneratedSource("go", 1<<20)
+	if err != nil {
+		b.Fatal(err)
+	}
+	if len(source) != 1048591 || fmt.Sprintf("%x", sha256.Sum256(source)) != "76c70b62127085d3c791ba98a24cba9f22bd343e40afb43522bbb5041cede524" {
+		b.Fatal("large Go witness changed")
+	}
+	lang := grammars.GoLanguage()
+	warm := gotreesitter.NewParser(lang)
+	warm.SetAdmissionCandidateRoute(true)
+	tree, err := warm.Parse([]byte("package p\n"))
+	if err != nil || tree == nil {
+		b.Fatalf("warm tables: %v", err)
+	}
+	tree.Release()
+	gotreesitter.ResetAdmissionCandidateCountersForTest()
+	b.ReportAllocs()
+	b.SetBytes(int64(len(source)))
+	b.ResetTimer()
+	for range b.N {
+		p := gotreesitter.NewParser(lang)
+		p.SetAdmissionCandidateRoute(true)
+		tree, err := p.Parse(source)
+		if err != nil || tree == nil {
+			b.Fatalf("large Go parse: %v", err)
+		}
+		rt := tree.ParseRuntime()
+		if tree.RootNode().HasError() || tree.RootNode().EndByte() != uint32(len(source)) || rt.NodesAllocated != 903086 || rt.TokensConsumed != 425742 {
+			b.Fatalf("large Go work or completion changed: %s", rt.Summary())
+		}
+		tree.Release()
+	}
+	b.StopTimer()
+	routed, fallback := gotreesitter.AdmissionCandidateCounters()
+	if routed != uint64(b.N) || fallback != 0 {
+		b.Fatalf("large Go route compact=%d fallback=%d", routed, fallback)
+	}
+}
diff --git a/internal/parsercorephase0/arena_projection.go b/internal/parsercorephase0/arena_projection.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/arena_projection.go
@@ -0,0 +1,69 @@
+package parsercorephase0
+
+// ProjectRecordArenas takes one late capacity estimate from work already done.
+// It never changes a live record or a limit. maxAdditionalBytes bounds the
+// total increase in retained capacity; zero means no caller ceiling is armed.
+func (c *Core) ProjectRecordArenas(sourceBytes int, progress uint32, maxAdditionalBytes uint64) bool {
+	if c == nil || sourceBytes <= 0 || uint64(sourceBytes) > uint64(^uint32(0)) || progress == 0 || uint64(progress) >= uint64(sourceBytes) || uint64(progress)*2 < uint64(sourceBytes) {
+		return false
+	}
+	project := func(count int, limit uint32) int {
+		value := (uint64(min(count, 1<<31-1))*uint64(sourceBytes) + uint64(progress) - 1) / uint64(progress)
+		value = (value*17 + 15) / 16
+		value = min(value, uint64(limit), uint64(1<<31-1))
+		return int(value)
+	}
+	nodes := project(len(c.nodes), c.limits.MaxNodes)
+	links := project(len(c.links), c.limits.MaxLinks)
+	subtrees := project(len(c.subtrees), c.limits.MaxSubtrees)
+	children := project(len(c.children), c.limits.MaxChildren)
+	delta := func(want, capacity int, size uint64) uint64 {
+		if want <= capacity {
+			return 0
+		}
+		return uint64(want-capacity) * size
+	}
+	additional := delta(nodes, cap(c.nodes), coreNodeRecordBytes) + delta(nodes, cap(c.nodeLineages), coreNodeLineageRecordBytes) + delta(links, cap(c.links), coreLinkRecordBytes) + delta(subtrees, cap(c.subtrees), coreSubtreeRecordBytes) + delta(children, cap(c.children), coreChildRecordBytes)
+	if additional == 0 || (maxAdditionalBytes > 0 && additional > maxAdditionalBytes) {
+		return false
+	}
+	c.nodes = growArena(c.nodes, nodes)
+	c.nodeLineages = growArena(c.nodeLineages, nodes)
+	c.links = growArena(c.links, links)
+	c.subtrees = growArena(c.subtrees, subtrees)
+	c.children = growArena(c.children, children)
+	return true
+}
+
+// RecordArenaProjectionStart returns the first byte at or beyond halfway.
+// Invalid or unrepresentable source lengths cannot arm a projection.
+func RecordArenaProjectionStart(sourceBytes int) uint32 {
+	if sourceBytes <= 1 || uint64(sourceBytes) > uint64(^uint32(0)) {
+		return 0
+	}
+	return uint32(sourceBytes/2 + sourceBytes%2)
+}
+
+// RecordArenaProjectionBudget leaves at least three quarters of every armed
+// limit's remaining capacity for later parse work. No armed limit means no
+// caller ceiling. A spent limit refuses projection instead of treating zero
+// remaining bytes as an unlimited ceiling.
+func RecordArenaProjectionBudget(footprint uint64, budgetBytes, ceilingBytes int64) (uint64, bool) {
+	available := uint64(0)
+	for _, limit := range [2]int64{budgetBytes, ceilingBytes} {
+		if limit <= 0 {
+			continue
+		}
+		if uint64(limit) <= footprint {
+			return 0, false
+		}
+		remaining := (uint64(limit) - footprint) / 4
+		if remaining == 0 {
+			return 0, false
+		}
+		if available == 0 || remaining < available {
+			available = remaining
+		}
+	}
+	return available, true
+}
diff --git a/internal/parsercorephase0/arena_projection_test.go b/internal/parsercorephase0/arena_projection_test.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/arena_projection_test.go
@@ -0,0 +1,160 @@
+package parsercorephase0
+
+import (
+	"reflect"
+	"strconv"
+	"testing"
+)
+
+func projectionFixture(t *testing.T) *Core {
+	t.Helper()
+	c := reserveTestCore(t, reserveTestLimits())
+	c.nodes = make([]nodeRecord, 100)
+	c.nodeLineages = make([]nodeLineageHot, 100)
+	c.links = make([]linkRecord, 90)
+	c.subtrees = make([]subtreeRecord, 80)
+	c.children = make([]SubtreeID, 75)
+	for i := range c.nodes {
+		c.nodes[i].byteOffset = uint32(i)
+		c.nodeLineages[i].owner = uint32(i + 1)
+	}
+	for i := range c.links {
+		c.links[i].prev = NodeID(i + 1)
+	}
+	for i := range c.subtrees {
+		c.subtrees[i].symbol = Symbol(i + 1)
+	}
+	for i := range c.children {
+		c.children[i] = SubtreeID(i + 1)
+	}
+	return c
+}
+
+func TestProjectRecordArenasPreservesPublishedRecordsAndWork(t *testing.T) {
+	c := projectionFixture(t)
+	nodes := append([]nodeRecord(nil), c.nodes...)
+	lineages := append([]nodeLineageHot(nil), c.nodeLineages...)
+	links := append([]linkRecord(nil), c.links...)
+	subtrees := append([]subtreeRecord(nil), c.subtrees...)
+	children := append([]SubtreeID(nil), c.children...)
+	storage, work := c.StorageBytes(), c.Work()
+	before := c.FootprintBytes()
+	if !c.ProjectRecordArenas(10000, 5000, 1<<20) {
+		t.Fatal("projection did not grow")
+	}
+	if !reflect.DeepEqual(c.nodes, nodes) || !reflect.DeepEqual(c.nodeLineages, lineages) || !reflect.DeepEqual(c.links, links) || !reflect.DeepEqual(c.subtrees, subtrees) || !reflect.DeepEqual(c.children, children) {
+		t.Fatal("projection changed published records")
+	}
+	if c.StorageBytes() != storage || c.Work() != work {
+		t.Fatal("projection changed storage or work")
+	}
+	if after := c.FootprintBytes(); after <= before || after-before > 1<<20 {
+		t.Fatalf("capacity delta outside ceiling: %d -> %d", before, after)
+	}
+	if got := testing.AllocsPerRun(10, func() { c.ProjectRecordArenas(10000, 5000, 1<<20) }); got != 0 {
+		t.Fatalf("warm projection allocated %g times", got)
+	}
+}
+
+func TestProjectRecordArenasRejectsWholeGrowthWithoutChangingCapacity(t *testing.T) {
+	c := projectionFixture(t)
+	before := c.FootprintBytes()
+	pointers := [5]any{&c.nodes[0], &c.nodeLineages[0], &c.links[0], &c.subtrees[0], &c.children[0]}
+	if c.ProjectRecordArenas(10000, 5000, 1) {
+		t.Fatal("projection exceeded caller ceiling")
+	}
+	afterPointers := [5]any{&c.nodes[0], &c.nodeLineages[0], &c.links[0], &c.subtrees[0], &c.children[0]}
+	if c.FootprintBytes() != before || pointers != afterPointers {
+		t.Fatal("rejected projection allocated partial capacity")
+	}
+}
+
+func TestProjectRecordArenasRequiresLateBoundedSourceProgress(t *testing.T) {
+	c := projectionFixture(t)
+	inputs := []struct {
+		source   int
+		progress uint32
+	}{{-1, 1}, {0, 1}, {10000, 0}, {10000, 4999}, {10000, 10000}, {10000, 10001}}
+	if strconv.IntSize == 64 {
+		source := uint64(1) << 32
+		inputs = append(inputs, struct {
+			source   int
+			progress uint32
+		}{int(source), 1 << 31})
+	}
+	before := c.FootprintBytes()
+	for _, in := range inputs {
+		if c.ProjectRecordArenas(in.source, in.progress, 0) {
+			t.Fatalf("projected invalid progress %+v", in)
+		}
+	}
+	var nilCore *Core
+	if nilCore.ProjectRecordArenas(10000, 5000, 0) {
+		t.Fatal("nil core projected")
+	}
+	if c.FootprintBytes() != before {
+		t.Fatal("invalid progress allocated")
+	}
+}
+
+func TestProjectRecordArenasHonorsRecordLimitsAtLargestSource(t *testing.T) {
+	c := projectionFixture(t)
+	c.limits.MaxNodes, c.limits.MaxLinks, c.limits.MaxSubtrees, c.limits.MaxChildren = 120, 110, 100, 90
+	// MaxInt32 is representable on every supported architecture. On 64-bit,
+	// also cover the entire uint32 source range without a large allocation.
+	source, progress := int(1<<31-1), uint32(1<<30)
+	if strconv.IntSize == 64 {
+		value := uint64(1<<32 - 1)
+		source, progress = int(value), 1<<31
+	}
+	if !c.ProjectRecordArenas(source, progress, 0) {
+		t.Fatal("bounded large-source projection did not grow")
+	}
+	if cap(c.nodes) > 120 || cap(c.nodeLineages) > 120 || cap(c.links) > 110 || cap(c.subtrees) > 100 || cap(c.children) > 90 {
+		t.Fatal("projection exceeded record limits")
+	}
+}
+
+func TestRecordArenaProjectionBudgetHonorsEachArmedLimit(t *testing.T) {
+	for _, tc := range []struct {
+		used       uint64
+		soft, hard int64
+		want       uint64
+		ok         bool
+	}{
+		{100, 0, 0, 0, true}, {100, -1, -1, 0, true},
+		{100, 500, 0, 100, true}, {100, 0, 500, 100, true},
+		{100, 500, 900, 100, true}, {100, 900, 500, 100, true},
+		{100, 100, 500, 0, false}, {100, 500, 99, 0, false},
+		{100, 103, 500, 0, false}, {^uint64(0), 500, 500, 0, false},
+	} {
+		got, ok := RecordArenaProjectionBudget(tc.used, tc.soft, tc.hard)
+		if got != tc.want || ok != tc.ok {
+			t.Fatalf("budget(%d,%d,%d)=(%d,%t), want (%d,%t)", tc.used, tc.soft, tc.hard, got, ok, tc.want, tc.ok)
+		}
+	}
+}
+
+func TestRecordArenaProjectionStartCannotMissOddLengthMidpoint(t *testing.T) {
+	for _, source := range []int{2, 3, 9, 10, 1025, 10000, 1048591, 1<<31 - 1} {
+		start := RecordArenaProjectionStart(source)
+		if uint64(start)*2 < uint64(source) || uint64(start) >= uint64(source) {
+			t.Fatalf("source %d armed invalid midpoint %d", source, start)
+		}
+		c := projectionFixture(t)
+		if !c.ProjectRecordArenas(source, start, 1<<20) {
+			t.Fatalf("source %d rejected its scheduled projection at %d", source, start)
+		}
+	}
+	for _, source := range []int{-1, 0, 1} {
+		if RecordArenaProjectionStart(source) != 0 {
+			t.Fatalf("armed invalid source %d", source)
+		}
+	}
+	if strconv.IntSize == 64 {
+		source := uint64(1) << 32
+		if RecordArenaProjectionStart(int(source)) != 0 {
+			t.Fatal("armed unrepresentable source")
+		}
+	}
+}

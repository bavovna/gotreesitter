diff --git a/internal/parsercorephase0/dfa_terminal_identity.go b/internal/parsercorephase0/dfa_terminal_identity.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/dfa_terminal_identity.go
@@ -0,0 +1,94 @@
+package parsercorephase0
+
+import (
+	"errors"
+	"unsafe"
+)
+
+// SharedDFATerminalSource authenticates the complete token elected by the
+// adapter's actual internal DFA source. An owner-scoped dispatch must be
+// active; matching scalar token values alone must never return true.
+type SharedDFATerminalSource interface {
+	AuthenticatesSharedDFATerminal(Token) bool
+}
+
+type freshDFATerminalIdentity struct {
+	source     SharedDFATerminalSource
+	owner      SchedulerTransactionToken
+	generation uint64
+	certified  []uint64
+}
+
+// BindFreshDFATerminalSourceOwned binds one source to this fresh owner and
+// reset generation, before any payload exists. No transaction, nested binding
+// or later source replacement can issue receipts for existing payloads.
+func (c *Core) BindFreshDFATerminalSourceOwned(owner SchedulerTransactionToken, source SharedDFATerminalSource) (err error) {
+	if err = c.beginSchedulerOwned(owner); err != nil {
+		return err
+	}
+	defer c.recoverSchedulerOwnedPanic(owner)
+	if !c.schedulerFrame.fresh || source == nil || len(c.subtrees) != 0 || c.freshDFATerminalIdentityActive() {
+		return c.finishSchedulerOwned(owner, errors.New("parser-core phase zero: DFA identity source requires one empty fresh session"))
+	}
+	if c.dfaTerminalIdentity == nil {
+		c.dfaTerminalIdentity = new(freshDFATerminalIdentity)
+	}
+	state := c.dfaTerminalIdentity
+	clear(state.certified)
+	state.certified = state.certified[:0]
+	state.source, state.owner, state.generation = source, owner, c.resetGeneration
+	return c.finishSchedulerOwned(owner, nil)
+}
+
+func (c *Core) freshDFATerminalIdentityActive() bool {
+	state := c.dfaTerminalIdentity
+	return state != nil && state.source != nil && c.schedulerFrame.active && c.schedulerFrame.fresh &&
+		state.owner.owner == c && state.owner.epoch == c.schedulerFrame.epoch &&
+		state.owner.transaction == c.schedulerFrame.mark.transaction && state.generation == c.resetGeneration
+}
+
+func (c *Core) clearFreshDFATerminalIdentity() {
+	if state := c.dfaTerminalIdentity; state != nil {
+		state.source = nil
+		state.owner = SchedulerTransactionToken{}
+		state.generation = 0
+		clear(state.certified)
+		state.certified = state.certified[:0]
+	}
+}
+
+func (c *Core) recordFreshDFATerminalIdentity(id SubtreeID, record subtreeRecord, prefix uint16) {
+	if !c.freshDFATerminalIdentityActive() || record.external || record.missing || record.symbol == 0 || record.symbol >= ErrorRegionSymbol-1 {
+		return
+	}
+	token := Token{Symbol: record.symbol, StartByte: record.startByte, EndByte: record.endByte, Extra: record.extra, LexerSkippedPrefixLength: prefix}
+	state := c.dfaTerminalIdentity
+	if !state.source.AuthenticatesSharedDFATerminal(token) {
+		return
+	}
+	want := uint64(id)/64 + 1
+	if want > uint64(cap(state.certified)) {
+		next := make([]uint64, want, max(want, 2*uint64(cap(state.certified)), 8))
+		copy(next, state.certified)
+		state.certified = next
+	} else {
+		state.certified = state.certified[:want]
+	}
+	state.certified[uint64(id)/64] |= uint64(1) << (uint64(id) % 64)
+}
+
+func (c *Core) freshDFATerminalIdentityExact(id SubtreeID) bool {
+	if id == 0 || !c.freshDFATerminalIdentityActive() {
+		return false
+	}
+	state := c.dfaTerminalIdentity
+	word := uint64(id) / 64
+	return word < uint64(len(state.certified)) && state.certified[word]&(uint64(1)<<(uint64(id)%64)) != 0
+}
+
+func (c *Core) freshDFATerminalIdentityFootprintBytes() uint64 {
+	if c.dfaTerminalIdentity == nil {
+		return 0
+	}
+	return uint64(unsafe.Sizeof(*c.dfaTerminalIdentity)) + uint64(cap(c.dfaTerminalIdentity.certified))*8
+}

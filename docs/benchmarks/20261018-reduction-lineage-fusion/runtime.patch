+func TestReductionOwnerMultiplePopRetainsPublicationPath(t *testing.T) {
+	setup := func() (*Core, Head) {
+		tables := &fakeTable{actions: map[tableCell][]Action{{state: 3, symbol: 9}: {{Type: ActionReduce, Symbol: 2, ChildCount: 1}}}, gotos: map[tableCell]StateID{{state: 1, symbol: 2}: 4}}
+		c, err := New(tables, Limits{MaxDerivations: 8, MaxPopPaths: 8})
+		if err != nil {
+			t.Fatal(err)
+		}
+		seed, err := c.Seed(1, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var head Head
+		for _, symbol := range []Symbol{7, 8} {
+			head, err = c.appendDiagnosticPayload(seed, 3, Token{Symbol: symbol, EndByte: 1}, pathMeta{})
+			if err != nil {
+				t.Fatal(err)
+			}
+		}
+		return c, head
+	}
+	before, oldHead := setup()
+	after, newHead := setup()
+	var old, got []ReductionOutput
+	if err := before.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		b, err := before.ClassifyBoundary(oldHead, 9)
+		if err != nil {
+			return err
+		}
+		old, err = before.ReduceOutputsCorridorClassifiedIntoWithLiveCondenseCandidatesOwned(owner, nil, nil, b, ForkOrder{})
+		return err
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := after.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		b, err := after.ClassifyBoundary(newHead, 9)
+		if err != nil {
+			return err
+		}
+		var published bool
+		got, published, err = after.ReduceOutputsAndPublishLineageOwned(owner, nil, nil, b, 0, ForkOrder{}, true, ShiftHeadLineage{Owner: 7, PublishLineage: true, Rank: CleanPathRankSelected, Lineage: 42, Set: NewAlternativeSetMember(42, 0)})
+		if published {
+			t.Fatal("multi-pop output published lineage early")
+		}
+		return err
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) == 0 {
+		t.Fatal("fixture has no outputs")
+	}
+	for _, out := range got {
+		if !out.MultiplePopPaths {
+			t.Fatal("fixture has no multiple-pop provenance")
+		}
+	}
+	if !reflect.DeepEqual(old, got) || !reflect.DeepEqual(before.nodes, after.nodes) || !reflect.DeepEqual(before.links, after.links) || !reflect.DeepEqual(before.subtrees, after.subtrees) || !reflect.DeepEqual(before.nodeLineages, after.nodeLineages) || !reflect.DeepEqual(captureSchedulerTransactionState(before), captureSchedulerTransactionState(after)) {
+		t.Fatal("multi-pop fallback changed state or work")
+	}
+}
+
+func TestReductionOwnerGeneralPathAuthenticatesClassification(t *testing.T) {
+	for _, fresh := range []bool{false, true} {
+		before, _ := newReductionOwnerFixture(t)
+		after, _ := newReductionOwnerFixture(t)
+		_, foreign := newReductionOwnerFixture(t)
+		run := func(c *Core, fn func(SchedulerTransactionToken) error) error {
+			if fresh {
+				return c.RunFreshSchedulerSession(fn)
+			}
+			return c.ApplySchedulerAtomic(fn)
+		}
+		oldErr := run(before, func(owner SchedulerTransactionToken) error {
+			_, err := before.ReduceOutputsClassifiedIntoWithLiveCondenseCandidatesOwned(owner, nil, nil, foreign, 0, ForkOrder{})
+			return err
+		})
+		newErr := run(after, func(owner SchedulerTransactionToken) error {
+			_, published, err := after.ReduceOutputsAndPublishLineageOwned(owner, nil, nil, foreign, 0, ForkOrder{}, false, ShiftHeadLineage{Owner: 7})
+			if published {
+				t.Fatal("foreign classification published an owner")
+			}
+			return err
+		})
+		if oldErr == nil || newErr == nil || oldErr.Error() != newErr.Error() || !strings.Contains(newErr.Error(), "another core") || !reflect.DeepEqual(captureSchedulerTransactionState(before), captureSchedulerTransactionState(after)) || !reflect.DeepEqual(before.nodeLineages, after.nodeLineages) {
+			t.Fatalf("fresh=%t classification checks or cleanup differ: old=%v new=%v", fresh, oldErr, newErr)
+		}
+	}
+}

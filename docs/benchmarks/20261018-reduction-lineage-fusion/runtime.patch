+package parsercorephase0
+
+import "errors"
+
+// ReduceOutputsAndPublishLineageOwned runs the existing authenticated
+// selected reduction and publishes lineage only for its new sole output with
+// no imported history or references. Every other output retains ordinary
+// scheduler publication. The caller proves that this result takes its in-place
+// header path, whose zero new reduction lineage preserves the supplied scalar
+// and alternative membership, and that no callback or canonicalization can
+// replace the header before its usual publication point.
+// corridorTrusted has the same validated-corridor obligation as the existing
+// corridor reduction entry. Otherwise the normal classification checks run.
+func (c *Core) ReduceOutputsAndPublishLineageOwned(
+	owner SchedulerTransactionToken,
+	candidates []CondenseCandidate,
+	dst []ReductionOutput,
+	boundary ClassifiedBoundary,
+	actionOrdinal int,
+	fork ForkOrder,
+	corridorTrusted bool,
+	publication ShiftHeadLineage,
+) (frontier []ReductionOutput, published bool, err error) {
+	if err = c.beginSchedulerOwned(owner); err != nil {
+		return frontier, false, err
+	}
+	defer c.recoverSchedulerOwnedPanic(owner)
+	if publication.Owner == 0 {
+		return frontier, false, c.finishSchedulerOwned(owner, errors.New("parser-core phase zero: zero scheduler lineage"))
+	}
+	if err = c.enterLiveCondenseCandidates(candidates); err != nil {
+		return frontier, false, c.finishSchedulerOwned(owner, err)
+	}
+	if !c.schedulerFrame.fresh {
+		defer c.clearLiveCondenseCandidates()
+	}
+	if corridorTrusted {
+		frontier, err = c.reduceOutputsCorridorClassifiedIntoUncheckpointed(owner, dst, boundary, fork)
+	} else {
+		frontier, err = c.reduceOutputsClassifiedIntoUncheckpointed(owner, dst, boundary, actionOrdinal, fork, nil)
+	}
+	c.clearLiveCondenseCandidates()
+	if err == nil && len(frontier) == 1 {
+		out := &frontier[0]
+		if out.Freshness == ReductionNew && !out.MultiplePopPaths &&
+			out.HistoricalBoundaryProvenance == HistoricalBoundaryNone &&
+			out.HistoricalAlternativeSet.Len() == 0 &&
+			out.DropCohortRefs.Empty() && !out.DropCohortRefs.Overflowed() && !out.DropCohortRefs.Blended() {
+			err = c.recordHeadOwner(out.Head, publication.Owner)
+			if err == nil && publication.PublishLineage {
+				err = c.publishShiftLineage(out.Head, publication)
+			}
+			published = err == nil
+		}
+	}
+	err = c.finishSchedulerOwned(owner, err)
+	if err != nil {
+		return frontier, false, err
+	}
+	return frontier, published, nil
+}

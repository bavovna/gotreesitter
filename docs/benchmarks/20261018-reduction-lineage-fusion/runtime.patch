+package parsercorephase0
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func newReductionOwnerFixture(t *testing.T) (*Core, ClassifiedBoundary) {
+	t.Helper()
+	c, err := New(&fakeTable{
+		actions: map[tableCell][]Action{{state: 1, symbol: 9}: {{Type: ActionReduce, Symbol: 4, ChildCount: 0}}},
+		gotos:   map[tableCell]StateID{{state: 1, symbol: 4}: 2},
+	}, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	head, err := c.Seed(1, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := c.ClassifyBoundary(head, 9)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c, b
+}
+
+func TestReductionOwnerMatchesSeparateOperations(t *testing.T) {
+	for _, trusted := range []bool{false, true} {
+		for _, fresh := range []bool{false, true} {
+			for _, scalar := range []bool{false, true} {
+				before, oldBoundary := newReductionOwnerFixture(t)
+				after, newBoundary := newReductionOwnerFixture(t)
+				pub := ShiftHeadLineage{Owner: 7, PublishLineage: scalar, Rank: CleanPathRankSelected, Lineage: 42, Set: NewAlternativeSetMember(42, 0)}
+				run := func(c *Core, fn func(SchedulerTransactionToken) error) error {
+					if fresh {
+						return c.RunFreshSchedulerSession(fn)
+					}
+					return c.ApplySchedulerAtomic(fn)
+				}
+				var old, got []ReductionOutput
+				if err := run(before, func(owner SchedulerTransactionToken) error {
+					var err error
+					if trusted {
+						old, err = before.ReduceOutputsCorridorClassifiedIntoWithLiveCondenseCandidatesOwned(owner, nil, nil, oldBoundary, ForkOrder{})
+					} else {
+						old, err = before.ReduceOutputsClassifiedIntoWithLiveCondenseCandidatesOwned(owner, nil, nil, oldBoundary, 0, ForkOrder{})
+					}
+					if err != nil {
+						return err
+					}
+					if err = before.RecordHeadOwnerOwned(owner, old[0].Head, pub.Owner); err != nil {
+						return err
+					}
+					if pub.PublishLineage {
+						return before.RecordHeadLineageOwned(owner, old[0].Head, pub.Rank, pub.Lineage, pub.Set, pub.Blended, true, DropCohortRefSet{})
+					}
+					return nil
+				}); err != nil {
+					t.Fatal(err)
+				}
+				if err := run(after, func(owner SchedulerTransactionToken) error {
+					var err error
+					var published bool
+					got, published, err = after.ReduceOutputsAndPublishLineageOwned(owner, nil, nil, newBoundary, 0, ForkOrder{}, trusted, pub)
+					if err == nil && !published {
+						t.Fatal("fresh sole output was not published")
+					}
+					return err
+				}); err != nil {
+					t.Fatal(err)
+				}
+				if !reflect.DeepEqual(old, got) || !reflect.DeepEqual(before.nodes, after.nodes) || !reflect.DeepEqual(before.links, after.links) || !reflect.DeepEqual(before.subtrees, after.subtrees) || !reflect.DeepEqual(before.nodeLineages, after.nodeLineages) || !reflect.DeepEqual(before.nodeLineageRecovery, after.nodeLineageRecovery) || !reflect.DeepEqual(before.alternativeSpillArena, after.alternativeSpillArena) || !reflect.DeepEqual(captureSchedulerTransactionState(before), captureSchedulerTransactionState(after)) {
+					t.Fatalf("fresh=%t scalar=%t combined reduction changed complete state/work", fresh, scalar)
+				}
+			}
+		}
+	}
+}
+
+func TestReductionOwnerRollbackAndZeroOwner(t *testing.T) {
+	c, b := newReductionOwnerFixture(t)
+	before := captureSchedulerTransactionState(c)
+	sentinel := errors.New("rollback reduction publication")
+	err := c.ApplySchedulerAtomic(func(owner SchedulerTransactionToken) error {
+		_, published, err := c.ReduceOutputsAndPublishLineageOwned(owner, nil, nil, b, 0, ForkOrder{}, true, ShiftHeadLineage{Owner: 7, PublishLineage: true, Rank: CleanPathRankSelected, Lineage: 42, Set: NewAlternativeSetMember(42, 0)})
+		if err != nil {
+			return err
+		}
+		if !published {
+			t.Fatal("owner absent before rollback")
+		}
+		return sentinel
+	})
+	if !errors.Is(err, sentinel) || !reflect.DeepEqual(before, captureSchedulerTransactionState(c)) {
+		t.Fatalf("rollback err=%v", err)
+	}
+	err = c.ApplySchedulerAtomic(func(owner SchedulerTransactionToken) error {
+		_, published, err := c.ReduceOutputsAndPublishLineageOwned(owner, nil, nil, b, 0, ForkOrder{}, true, ShiftHeadLineage{})
+		if published {
+			t.Fatal("zero owner published")
+		}
+		return err
+	})
+	if err == nil || !strings.Contains(err.Error(), "zero scheduler lineage") || !reflect.DeepEqual(before, captureSchedulerTransactionState(c)) {
+		t.Fatalf("zero owner err=%v", err)
+	}
+}
+
+func TestReductionOwnerCondensedHeadRetainsPublicationPath(t *testing.T) {
+	c, b := newReductionOwnerFixture(t)
+	err := c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		first, published, err := c.ReduceOutputsAndPublishLineageOwned(owner, nil, nil, b, 0, ForkOrder{}, true, ShiftHeadLineage{Owner: 7})
+		if err != nil {
+			return err
+		}
+		if !published {
+			t.Fatal("new output was not published")
+		}
+		again, published, err := c.ReduceOutputsAndPublishLineageOwned(owner, []CondenseCandidate{{Head: first[0].Head}}, nil, b, 0, ForkOrder{}, true, ShiftHeadLineage{Owner: 11})
+		if err != nil {
+			return err
+		}
+		if len(again) != 1 || again[0].Head != first[0].Head || published || c.nodeLineages[first[0].Head.Node-1].owner != 7 {
+			t.Fatalf("condensed owner overwritten: %+v published=%t", again, published)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}

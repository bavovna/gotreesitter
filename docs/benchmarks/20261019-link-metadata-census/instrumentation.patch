+// Diagnostic overlay only: retained graph geometry, never timing evidence.
+func (c *Core) emitLinkMetadataCensus(success bool) {
+	label := os.Getenv("GTS_LINK_METADATA_CENSUS")
+	if label == "" {
+		return
+	}
+	type metadata struct {
+		score int64
+		order uint64
+		flags uint32
+	}
+	unique := make(map[metadata]struct{})
+	var recent [4]metadata
+	used := 0
+	var cold, scores, orders, flags, next, hitsOne, hitsFour uint64
+	for _, link := range c.links {
+		if link.next != 0 {
+			next++
+		}
+		key := metadata{link.scoreDelta, link.order, link.flags}
+		if key == (metadata{}) {
+			continue
+		}
+		cold++
+		if key.score != 0 {
+			scores++
+		}
+		if key.order != 0 {
+			orders++
+		}
+		if key.flags != 0 {
+			flags++
+		}
+		unique[key] = struct{}{}
+		at := -1
+		for i := 0; i < used; i++ {
+			if recent[i] == key {
+				at = i
+				break
+			}
+		}
+		if at == 0 {
+			hitsOne++
+		}
+		if at >= 0 {
+			hitsFour++
+		}
+		if at < 0 {
+			at = used
+			if at == len(recent) {
+				at--
+			} else {
+				used++
+			}
+		}
+		for i := at; i > 0; i-- {
+			recent[i] = recent[i-1]
+		}
+		recent[0] = key
+	}
+	fmt.Printf("LINK_METADATA_CENSUS label=%s success=%t links=%d cold=%d unique=%d scores=%d orders=%d flags=%d next=%d recent1_hits=%d recent4_hits=%d full_record_bytes=%d\n", label, success, len(c.links), cold, len(unique), scores, orders, flags, next, hitsOne, hitsFour, unsafe.Sizeof(linkRecord{}))
+}

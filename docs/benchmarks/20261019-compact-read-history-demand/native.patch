diff --git a/parsercore_phase0_reuse_dependency.go b/parsercore_phase0_reuse_dependency.go
--- a/parsercore_phase0_reuse_dependency.go
+++ b/parsercore_phase0_reuse_dependency.go
@@ -360,0 +361,7 @@
+	// Only publication with replay can stamp reusable public nodes. A known
+	// no-replay request cannot consume this history; low-level scheduler
+	// callers without a materialization context keep the conservative path.
+	if s.options.materializationContextSet && !s.options.materializationForceReplayParseStates {
+		s.reuseDependencies.idleReads = nil
+		return
+	}
diff --git a/parsercore_phase0_reuse_dependency_scanner_internal_test.go b/parsercore_phase0_reuse_dependency_scanner_internal_test.go
--- a/parsercore_phase0_reuse_dependency_scanner_internal_test.go
+++ b/parsercore_phase0_reuse_dependency_scanner_internal_test.go
@@ -273,0 +274,36 @@
+
+func TestCompactCanonicalNoReplayReadHistory(t *testing.T) {
+	fixture := loadDiagnosticParserCoreCanonicalFixture(t, "grammargen_lr")
+	runner, err := newParserCoreFreshFullRunner(parserCoreWarmGoScanner, parserCoreFreshFullCanonicalOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var expected string
+	for _, row := range diagnosticParserCoreCanonicalAdmissions {
+		if row.id == fixture.ID {
+			requireDiagnosticParserCoreCanonicalFixtureIdentity(t, fixture, row)
+			expected = row.deepTreeSHA256
+		}
+	}
+	if expected == "" {
+		t.Fatal("missing source/digest pin")
+	}
+	for i := 0; i < 2; i++ {
+		tree, err := runner.parse(fixture.Source)
+		if err != nil {
+			t.Fatal(err)
+		}
+		digest := requireDiagnosticParserCoreCanonicalTreeDigest(t, tree, runner.lang)
+		disabled := tree.incrementalReuseDisabled
+		tree.Release()
+		if digest != expected {
+			t.Fatalf("deep tree changed: %s", digest)
+		}
+		if !disabled {
+			t.Fatal("no-replay publication unexpectedly enabled reuse")
+		}
+		if runner.scheduler.reuseDependencies.reads != nil || runner.scheduler.reuseDependencies.idleReads != nil {
+			t.Fatal("no-replay canonical parse collected unused history")
+		}
+	}
+}
diff --git a/parsercore_phase0_reuse_dependency_test.go b/parsercore_phase0_reuse_dependency_test.go
--- a/parsercore_phase0_reuse_dependency_test.go
+++ b/parsercore_phase0_reuse_dependency_test.go
@@ -576,0 +577,43 @@
+
+func TestCompactLegacyReadHistoryPublicationDemand(t *testing.T) {
+	for _, tc := range []struct {
+		name                     string
+		context, replay, collect bool
+	}{
+		{"unknown context", false, false, true},
+		{"replay publication", true, true, true},
+		{"no replay publication", true, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			d := &dfaTokenSource{language: &Language{}, lexer: NewLexer(nil, []byte("abcd"))}
+			s := &diagnosticParserCoreGenericScheduler{tokenSource: d}
+			// A prior eligible request leaves storage, never authorization.
+			s.beginCompactLegacyReads()
+			if s.reuseDependencies.reads == nil {
+				t.Fatal("control did not collect")
+			}
+			s.reuseDependencies.reads.Record(0, 2)
+			s.reuseDependencies.reads.Seal()
+			d.lexer.reuseReads = nil
+			s.reuseDependencies = s.reuseDependencies.reset()
+			if s.reuseDependencies.idleReads == nil {
+				t.Fatal("control did not retain scratch")
+			}
+			s.options.materializationContextSet = tc.context
+			s.options.materializationForceReplayParseStates = tc.replay
+			s.beginCompactLegacyReads()
+			if tc.collect {
+				if s.reuseDependencies.reads == nil || d.lexer.reuseReads != s.reuseDependencies.reads {
+					t.Fatal("required read history was not attached")
+				}
+				s.reuseDependencies.reads.Record(2, 4)
+				s.reuseDependencies.reads.Seal()
+				if end, ok := s.reuseDependencies.reads.Lookahead(3); !ok || end != 1 {
+					t.Fatalf("new history=%d/%t", end, ok)
+				}
+			} else if s.reuseDependencies.reads != nil || s.reuseDependencies.idleReads != nil || d.lexer.reuseReads != nil || s.reuseDependencies.readsAllocated != 0 {
+				t.Fatal("known no-replay publication collected or retained unused history")
+			}
+		})
+	}
+}

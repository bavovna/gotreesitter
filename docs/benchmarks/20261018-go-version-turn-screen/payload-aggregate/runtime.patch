@@ -0,0 +1,69 @@
+package parsercorephase0
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+type payloadPrecedenceProbeNode struct {
+	ID         SubtreeID
+	Symbol     Symbol
+	Production uint16
+	Local      int16
+}
+
+func (c *Core) probePayloadPrecedence(root SubtreeID) (int64, []payloadPrecedenceProbeNode, error) {
+	before := c.Work()
+	stack := []SubtreeID{root}
+	budget := len(c.subtrees) + len(c.children)
+	var total int64
+	var weighted []payloadPrecedenceProbeNode
+	for visits := 0; len(stack) > 0; visits++ {
+		if visits >= budget {
+			return 0, nil, fmt.Errorf("payload precedence probe budget")
+		}
+		id := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		r, err := c.subtree(id)
+		if err != nil {
+			return 0, nil, err
+		}
+		total += int64(r.dynamicPrecedence)
+		if r.dynamicPrecedence != 0 {
+			weighted = append(weighted, payloadPrecedenceProbeNode{id, r.symbol, r.productionID, r.dynamicPrecedence})
+		}
+		for i := r.childCount; i > 0; i-- {
+			child := c.children[r.firstChild+i-1]
+			if child == 0 || child >= id {
+				return 0, nil, fmt.Errorf("payload precedence probe child order")
+			}
+			stack = append(stack, child)
+		}
+	}
+	if c.Work() != before {
+		panic("precedence probe changed Core work")
+	}
+	return total, weighted, nil
+}
+func (c *Core) tracePayloadPrecedence(left, right SubtreeID, leftScore, rightScore int64) {
+	a, aw, ae := c.probePayloadPrecedence(left)
+	b, bw, be := c.probePayloadPrecedence(right)
+	row := struct {
+		Left, Right                   SubtreeID
+		LeftScore, RightScore         int64
+		LeftAggregate, RightAggregate int64
+		LeftWeights, RightWeights     []payloadPrecedenceProbeNode
+		LeftError, RightError         string
+	}{Left: left, Right: right, LeftScore: leftScore, RightScore: rightScore, LeftAggregate: a, RightAggregate: b, LeftWeights: aw, RightWeights: bw}
+	if ae != nil {
+		row.LeftError = ae.Error()
+	}
+	if be != nil {
+		row.RightError = be.Error()
+	}
+	data, err := json.Marshal(row)
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("PAYLOAD_PRECEDENCE %s\n", data)
+}

+func probeLegacyResultShape(p *Parser, arena *nodeArena, s *glrStack) string {
+	count := stackMaterializingResultEntryCount(s)
+	entries, ok := stackMaterializingResultEntries(s, make([]stackEntry, count), count)
+	if !ok {
+		return "<entries unavailable>"
+	}
+	budget := 512
+	var render func(rawStackWalkEntry) string
+	render = func(item rawStackWalkEntry) string {
+		budget--
+		if budget < 0 {
+			return "<budget>"
+		}
+		h, ok := cRawSubtreeHeaderForCompare(arena, item)
+		if !ok {
+			return "<raw unavailable>"
+		}
+		name := fmt.Sprintf("#%d", h.symbol)
+		if int(h.symbol) < len(p.language.SymbolNames) {
+			name = p.language.SymbolNames[h.symbol]
+		}
+		name += fmt.Sprintf("{dynamic:%d}", stackEntryDynamicPrecedence(item.entry))
+		if !h.childCountExact {
+			return "(" + name + " <count unavailable>)"
+		}
+		if h.childCount == 0 {
+			return name
+		}
+		if !h.canDescend {
+			return "(" + name + " <children unavailable>)"
+		}
+		var out strings.Builder
+		out.WriteByte('(')
+		out.WriteString(name)
+		for i := 0; i < h.childCount; i++ {
+			child, ok := cRawSubtreeChildForCompare(arena, item, i)
+			if !ok {
+				return "<child unavailable>"
+			}
+			out.WriteByte(' ')
+			out.WriteString(render(child))
+		}
+		out.WriteByte(')')
+		return out.String()
+	}
+	var roots []string
+	for _, entry := range entries {
+		roots = append(roots, render(rawStackWalkEntry{entry: entry}))
+	}
+	return strings.Join(roots, " ")
+}
+
+func probeLegacyPublicShape(p *Parser, s *glrStack) string {
+	var trees []string
+	for _, node := range resultNodesFromStack(s) {
+		if node != nil {
+			trees = append(trees, node.SExpr(p.language))
+		}
+	}
+	if len(trees) == 0 {
+		return "<no materialized roots>"
+	}
+	return strings.Join(trees, " ")
+}

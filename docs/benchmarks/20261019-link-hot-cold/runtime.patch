@@ -0,0 +1,152 @@
+package parsercorephase0
+
+import (
+	"errors"
+	"math"
+	"math/rand"
+	"testing"
+	"unsafe"
+)
+
+var linkMetadataArenaReadSink linkRecord
+
+func TestLinkMetadataArenaPreservesFullRecord(t *testing.T) {
+	if unsafe.Sizeof(linkHotRecord{}) != 16 {
+		t.Fatal("hot record must occupy 16 bytes")
+	}
+	var arena linkMetadataArena
+	records := []linkRecord{{}, {prev: NodeID(math.MaxUint32), payload: SubtreeID(math.MaxUint32), next: LinkID(math.MaxUint32)}, {scoreDelta: math.MinInt64, order: math.MaxUint64, flags: math.MaxUint32}, {scoreDelta: math.MaxInt64, order: math.MaxUint64 - 1, flags: linkFlagRecoveryDiscontinuity}}
+	rng := rand.New(rand.NewSource(38601))
+	for i := 0; i < 5000; i++ {
+		records = append(records, linkRecord{scoreDelta: int64(rng.Uint64()), order: rng.Uint64(), prev: NodeID(rng.Uint32()), payload: SubtreeID(rng.Uint32()), next: LinkID(rng.Uint32()), flags: rng.Uint32()})
+	}
+	hot := make([]linkHotRecord, len(records))
+	for i, record := range records {
+		hot[i] = arena.encode(record)
+	}
+	for i, want := range records {
+		if got := arena.decode(hot[i]); got != want {
+			t.Fatalf("record %d got %+v want %+v", i, got, want)
+		}
+	}
+	if len(arena.records) != len(records)-2 {
+		t.Fatal("zero metadata should be implicit")
+	}
+	copy := arena.decode(hot[2])
+	copy.scoreDelta = 0
+	if arena.decode(hot[2]) != records[2] {
+		t.Fatal("returned value mutated shared metadata")
+	}
+}
+
+func TestLinkMetadataArenaSharesNearbyValuesAndRollsBack(t *testing.T) {
+	var arena linkMetadataArena
+	keys := []linkRecord{{scoreDelta: -1}, {order: math.MaxUint64, flags: linkFlagHasOrder}, {flags: linkFlagRecoveryDiscontinuity}, {scoreDelta: math.MinInt64, order: math.MaxUint64, flags: math.MaxUint32}}
+	saved := make([]linkHotRecord, len(keys))
+	for i, key := range keys {
+		saved[i] = arena.encode(key)
+	}
+	for i := 0; i < 40; i++ {
+		for j := len(keys) - 1; j >= 0; j-- {
+			hot := arena.encode(keys[j])
+			if hot.metadata != saved[j].metadata {
+				t.Fatal("nearby metadata was not shared")
+			}
+		}
+	}
+	if len(arena.records) != 4 {
+		t.Fatal("cache added duplicate nearby records")
+	}
+	mark := len(arena.records)
+	abandoned := arena.encode(linkRecord{scoreDelta: 123, order: 456, flags: 789})
+	arena.truncate(mark)
+	replacement := linkRecord{scoreDelta: 321, order: 654, flags: 987}
+	fresh := arena.encode(replacement)
+	if fresh.metadata != abandoned.metadata || arena.decode(fresh) != replacement {
+		t.Fatal("rollback retained a stale cached index")
+	}
+	for i, want := range keys {
+		if arena.decode(saved[i]) != want {
+			t.Fatal("rollback changed a retained record")
+		}
+	}
+	arena.truncate(0)
+	if len(arena.records) != 0 || arena.recent != ([4]uint32{}) {
+		t.Fatal("reset retained live metadata")
+	}
+	arena.release()
+	if arena.records != nil || arena.recent != ([4]uint32{}) {
+		t.Fatal("release retained storage")
+	}
+}

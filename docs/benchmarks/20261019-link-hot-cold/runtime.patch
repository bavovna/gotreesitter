+func TestLinkMetadataArenaZeroAndSharedReadsAllocateNothing(t *testing.T) {
+	var arena linkMetadataArena
+	plain := arena.encode(linkRecord{prev: 17, payload: 19, next: 23})
+	if plain.metadata != 0 || len(arena.records) != 0 {
+		t.Fatal("plain graph link allocated metadata")
+	}
+	key := linkRecord{prev: 17, payload: 19, next: 23, scoreDelta: math.MinInt64, order: math.MaxUint64, flags: math.MaxUint32}
+	hot := arena.encode(key)
+	if n := testing.AllocsPerRun(1000, func() {
+		linkMetadataArenaReadSink = arena.decode(plain)
+		linkMetadataArenaReadSink = arena.decode(hot)
+		_ = arena.encode(key)
+	}); n != 0 {
+		t.Fatalf("shared metadata reads allocate %v", n)
+	}
+}

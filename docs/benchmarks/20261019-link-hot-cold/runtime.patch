+package parsercorephase0
+
+import "math"
+
+// linkHotRecord keeps full-width graph identities together. Metadata zero
+// names the implicit all-zero value; other values identify immutable records.
+type linkHotRecord struct {
+	prev     NodeID
+	payload  SubtreeID
+	next     LinkID
+	metadata uint32
+}
+
+type linkColdRecord struct {
+	scoreDelta int64
+	order      uint64
+	flags      uint32
+}
+
+// A bounded cache shares nearby repeated metadata without a second hash table.
+// Misses append an immutable record; rollback invalidates every cached index.
+type linkMetadataArena struct {
+	records []linkColdRecord
+	recent  [4]uint32
+}
+
+func (a *linkMetadataArena) encode(link linkRecord) linkHotRecord {
+	metadata := uint32(0)
+	key := linkColdRecord{scoreDelta: link.scoreDelta, order: link.order, flags: link.flags}
+	if key != (linkColdRecord{}) {
+		metadata = a.intern(key)
+	}
+	return linkHotRecord{prev: link.prev, payload: link.payload, next: link.next, metadata: metadata}
+}
+
+func (a *linkMetadataArena) intern(key linkColdRecord) uint32 {
+	for index, id := range a.recent {
+		if id == 0 {
+			break
+		}
+		if a.records[id-1] == key {
+			copy(a.recent[1:index+1], a.recent[:index])
+			a.recent[0] = id
+			return id
+		}
+	}
+	// The Core's checked logical-link limit bounds this namespace as well.
+	if uint64(len(a.records)) >= math.MaxUint32 {
+		panic("parser-core phase zero: link metadata index overflow")
+	}
+	a.records = append(a.records, key)
+	id := uint32(len(a.records))
+	copy(a.recent[1:], a.recent[:len(a.recent)-1])
+	a.recent[0] = id
+	return id
+}
+
+func (a *linkMetadataArena) decode(hot linkHotRecord) linkRecord {
+	var key linkColdRecord
+	if hot.metadata != 0 {
+		key = a.records[hot.metadata-1]
+	}
+	return linkRecord{prev: hot.prev, payload: hot.payload, next: hot.next, scoreDelta: key.scoreDelta, order: key.order, flags: key.flags}
+}
+
+func (a *linkMetadataArena) truncate(length int) {
+	a.records = a.records[:length]
+	clear(a.recent[:])
+}
+
+func (a *linkMetadataArena) release() {
+	a.records = nil
+	clear(a.recent[:])
+}
+
+// graphLinkAt preserves the immutable logical record while its storage uses
+// a dense identity plane and an optional shared metadata plane.
+func (c *Core) graphLinkAt(index int) linkRecord {
+	return c.linkMetadata.decode(c.links[index])
+}

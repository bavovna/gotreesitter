+func (c *Core) setGraphLinkForTest(index int, link linkRecord) {
+	c.links[index] = c.linkMetadata.encode(link)
+}
+func graphLinkRecordsForTest(c *Core) []linkRecord {
+	records := make([]linkRecord, len(c.links))
+	for index := range records {
+		records[index] = c.graphLinkAt(int(index))
+	}
+	return records
+}
+func TestLinkMetadataCoreRollbackRestoresLogicalRecords(t *testing.T) {
+	compact, err := New(&fakeTable{}, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseStorage := compact.StorageBytes()
+	original := linkRecord{scoreDelta: 7, order: 11, flags: linkFlagHasOrder}
+	compact.appendGraphLink(original)
+	metadataLength := len(compact.linkMetadata.records)
+	declined := errors.New("trial declined")
+	err = compact.ApplyAtomic(func() error {
+		compact.appendGraphLink(linkRecord{scoreDelta: 13, order: 17, flags: linkFlagHasOrder})
+		return declined
+	})
+	if !errors.Is(err, declined) {
+		t.Fatal(err)
+	}
+	if len(compact.links) != 1 || len(compact.linkMetadata.records) != metadataLength || compact.graphLinkAt(int(0)) != original || compact.linkMetadata.recent != ([4]uint32{}) {
+		t.Fatal("rollback retained trial metadata or changed a surviving link")
+	}
+	replacement := linkRecord{scoreDelta: 19, order: 23, flags: linkFlagHasOrder}
+	compact.appendGraphLink(replacement)
+	if compact.graphLinkAt(int(0)) != original || compact.graphLinkAt(int(1)) != replacement {
+		t.Fatal("post-rollback metadata index aliases an abandoned value")
+	}
+	wantStorage := baseStorage + uint64(len(compact.links))*coreLinkRecordBytes + uint64(len(compact.linkMetadata.records))*coreLinkMetadataBytes
+	if compact.StorageBytes() != wantStorage {
+		t.Fatalf("storage=%d want %d", compact.StorageBytes(), wantStorage)
+	}
+	metadata := compact.linkMetadata
+	footprint, dominant := compact.FootprintBytes(), compact.DominantCapacityBytes()
+	compact.linkMetadata = linkMetadataArena{}
+	withoutMetadata, dominantWithout := compact.FootprintBytes(), compact.DominantCapacityBytes()
+	compact.linkMetadata = metadata
+	wantColdCapacity := uint64(cap(metadata.records)) * coreLinkMetadataBytes
+	if footprint-withoutMetadata != wantColdCapacity || dominant-dominantWithout != wantColdCapacity {
+		t.Fatal("metadata capacity omitted from memory-stop accounting")
+	}
+	compact.releaseRecordArenaReserve()
+	if compact.linkMetadata.records != nil {
+		t.Fatal("release retained metadata")
+	}
+}

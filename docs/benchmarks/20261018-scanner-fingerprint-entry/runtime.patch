+// scannerValueFingerprint retains complete value binding encoding and its
+// deterministic fallback. Keeping the 4 KiB workspace here isolates it from
+// the common pointer-identity and nil paths.
+func scannerValueFingerprint(value reflect.Value, scanner any) [32]byte {
+	var buffer [4096]byte
+	encoded, ok := appendScannerIdentity(buffer[:0], value)
+	if !ok {
+		// Preserve the existing identity rule for unusual scanner values such as
+		// maps. In particular, fmt sorts map keys rather than using range order.
+		return sha256.Sum256([]byte(fmt.Sprintf("%T:%#v", scanner, scanner)))
+	}
+	return sha256.Sum256(encoded)
+}

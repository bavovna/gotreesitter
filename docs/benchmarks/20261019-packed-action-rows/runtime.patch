diff --git a/internal/parsercorephase0/packed_actions.go b/internal/parsercorephase0/packed_actions.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/packed_actions.go
@@ -0,0 +1,60 @@
+package parsercorephase0
+
+// Shift state and reduction metadata share the same word. A row with any
+// otherwise unused field set retains every field in the two-word encoding.
+func actionFitsPackedWord(a Action) bool {
+	switch a.Type {
+	case ActionShift:
+		return a.Symbol == 0 && a.ChildCount == 0 && a.DynamicPrecedence == 0 && a.ProductionID == 0
+	case ActionReduce:
+		return a.State == 0
+	case ActionAccept, ActionRecover:
+		return a.State == 0 && a.Symbol == 0 && a.ChildCount == 0 && a.DynamicPrecedence == 0 && a.ProductionID == 0
+	default:
+		return false
+	}
+}
+func encodePackedAction(a Action) uint64 {
+	word := uint64(a.Type)
+	if a.Extra {
+		word |= 1 << 2
+	}
+	if a.ExtraChain {
+		word |= 1 << 3
+	}
+	if a.Repetition {
+		word |= 1 << 4
+	}
+	if a.Type == ActionShift {
+		return word | uint64(a.State)<<5
+	}
+	return word | uint64(a.Symbol)<<5 | uint64(a.ChildCount)<<21 | uint64(uint16(a.DynamicPrecedence))<<29 | uint64(a.ProductionID)<<45
+}
+func decodePackedAction(word uint64) Action {
+	a := Action{Type: ActionType(word & 3), Extra: word&(1<<2) != 0, ExtraChain: word&(1<<3) != 0, Repetition: word&(1<<4) != 0}
+	if a.Type == ActionShift {
+		a.State = StateID(uint32(word >> 5))
+		return a
+	}
+	a.Symbol = Symbol(uint16(word >> 5))
+	a.ChildCount = uint8(word >> 21)
+	a.DynamicPrecedence = int16(uint16(word >> 29))
+	a.ProductionID = uint16(word >> 45)
+	return a
+}
+func encodeWideAction(a Action) (uint64, uint64) {
+	first := uint64(a.Type) | uint64(a.State)<<16 | uint64(a.Symbol)<<48
+	if a.Extra {
+		first |= 1 << 8
+	}
+	if a.ExtraChain {
+		first |= 1 << 9
+	}
+	if a.Repetition {
+		first |= 1 << 10
+	}
+	return first, uint64(a.ChildCount) | uint64(uint16(a.DynamicPrecedence))<<8 | uint64(a.ProductionID)<<24
+}
+func decodeWideAction(first, second uint64) Action {
+	return Action{Type: ActionType(uint8(first)), State: StateID(uint32(first >> 16)), Symbol: Symbol(uint16(first >> 48)), ChildCount: uint8(second), DynamicPrecedence: int16(uint16(second >> 8)), ProductionID: uint16(second >> 24), Extra: first&(1<<8) != 0, ExtraChain: first&(1<<9) != 0, Repetition: first&(1<<10) != 0}
+}
diff --git a/internal/parsercorephase0/packed_actions_test.go b/internal/parsercorephase0/packed_actions_test.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/packed_actions_test.go
@@ -0,0 +1,101 @@
+package parsercorephase0
+
+import (
+	"math"
+	"math/rand"
+	"testing"
+	"unsafe"
+)
+
+var packedActionSink Action
+
+func TestPackedActionRowsPreserveEveryFieldAndFlag(t *testing.T) {
+	check := func(actions []Action) {
+		t.Helper()
+		row := NewActionRow(actions, true)
+		if row.Len() != len(actions) || row.Descriptor() != describeActionRow(actions) || !row.Reusable() {
+			t.Fatal("row metadata changed")
+		}
+		for i, want := range actions {
+			if got := row.At(i); got != want {
+				t.Fatalf("action[%d]=%+v want=%+v", i, got, want)
+			}
+		}
+		if len(actions) > 0 {
+			actions[0] = Action{Type: ActionType(255)}
+			if row.At(0) == actions[0] {
+				t.Fatal("caller mutation changed immutable row")
+			}
+		}
+	}
+	wantHeader := uintptr(32)
+	if unsafe.Sizeof(uintptr(0)) == 4 {
+		wantHeader = 20
+	}
+	if unsafe.Sizeof(Action{}) != 20 || unsafe.Sizeof(actionRowData{}) != wantHeader {
+		t.Fatal("unexpected source or row header width")
+	}
+	for flags := 0; flags < 8; flags++ {
+		a := Action{Extra: flags&1 != 0, ExtraChain: flags&2 != 0, Repetition: flags&4 != 0}
+		for _, state := range []StateID{0, 1, 65535, 65536, math.MaxUint32} {
+			a.Type = ActionShift
+			a.State = state
+			check([]Action{a})
+		}
+		a.State = 0
+		a.Type = ActionReduce
+		for _, symbol := range []Symbol{0, math.MaxUint16} {
+			for _, children := range []uint8{0, 255} {
+				for _, prec := range []int16{math.MinInt16, -1, 0, math.MaxInt16} {
+					for _, prod := range []uint16{0, math.MaxUint16} {
+						a.Symbol = symbol
+						a.ChildCount = children
+						a.DynamicPrecedence = prec
+						a.ProductionID = prod
+						check([]Action{a})
+					}
+				}
+			}
+		}
+		for _, kind := range []ActionType{ActionAccept, ActionRecover} {
+			check([]Action{{Type: kind, Extra: a.Extra, ExtraChain: a.ExtraChain, Repetition: a.Repetition}})
+		}
+	}
+	rng := rand.New(rand.NewSource(86401))
+	for i := 0; i < 5000; i++ {
+		a := Action{Type: ActionType(rng.Uint32()), State: StateID(rng.Uint32()), Symbol: Symbol(rng.Uint32()), ChildCount: uint8(rng.Uint32()), DynamicPrecedence: int16(rng.Uint32()), ProductionID: uint16(rng.Uint32()), Extra: rng.Intn(2) != 0, ExtraChain: rng.Intn(2) != 0, Repetition: rng.Intn(2) != 0}
+		check([]Action{a, {Type: ActionShift, State: 65536}})
+	}
+}
+
+func TestPackedActionRowsStorageAndExceptionalValues(t *testing.T) {
+	a := NewActionRow([]Action{{Type: ActionShift, State: math.MaxUint32}, {Type: ActionReduce, Symbol: 65535, ChildCount: 255, DynamicPrecedence: math.MinInt16, ProductionID: 65535}}, false)
+	if a.data.wide || len(a.data.words) != 2 || cap(a.data.words) != 2 {
+		t.Fatal("ordinary actions do not occupy eight bytes each")
+	}
+	unusual := Action{Type: ActionShift, State: math.MaxUint32, Symbol: 65535, ChildCount: 255, DynamicPrecedence: math.MinInt16, ProductionID: 65535, Extra: true, ExtraChain: true, Repetition: true}
+	b := NewActionRow([]Action{unusual}, false)
+	if !b.data.wide || len(b.data.words) != 2 || b.At(0) != unusual {
+		t.Fatal("exceptional action lost fields")
+	}
+	for _, row := range []ActionRow{a, b, NewActionRow(nil, true)} {
+		for _, index := range []int{-1, row.Len(), math.MaxInt, math.MinInt, math.MinInt / 2} {
+			func() {
+				defer func() {
+					if recover() == nil {
+						t.Errorf("index %d did not panic for length %d", index, row.Len())
+					}
+				}()
+				row.At(index)
+			}()
+		}
+	}
+}
+
+func TestPackedActionReadsAllocateNothing(t *testing.T) {
+	for _, row := range []ActionRow{NewActionRow([]Action{{Type: ActionReduce, Symbol: 7, ChildCount: 255, DynamicPrecedence: math.MinInt16, ProductionID: 65535}}, false), NewActionRow([]Action{{Type: ActionShift, State: 65536, Symbol: 1}}, false)} {
+		if n := testing.AllocsPerRun(1000, func() { packedActionSink = row.At(0) }); n != 0 {
+			t.Fatalf("action read allocates %g", n)
+		}
+	}
+}

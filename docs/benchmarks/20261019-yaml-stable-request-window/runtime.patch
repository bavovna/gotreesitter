diff --git a/internal/parsercorephase0/stable_request_window.go b/internal/parsercorephase0/stable_request_window.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/stable_request_window.go
@@ -0,0 +1,45 @@
+package parsercorephase0
+
+import "math"
+
+// StableRequestWindow binds one-based immutable references to a compacted
+// sidecar. Dropping a prefix changes its indexes without renumbering surviving
+// references. A retired prefix never resolves to later entries.
+// The zero value starts at reference one. A scheduler reset starts a new window.
+type StableRequestWindow struct{ base uint32 }
+
+func (w StableRequestWindow) Reference(index int) (uint32, bool) {
+	if index < 0 || uint64(index) >= uint64(math.MaxUint32)-uint64(w.base) {
+		return 0, false
+	}
+	return w.base + uint32(index) + 1, true
+}
+
+func (w StableRequestWindow) Index(reference uint32, length int) (int, bool) {
+	if length < 0 || reference <= w.base {
+		return 0, false
+	}
+	index := uint64(reference) - uint64(w.base) - 1
+	if index >= uint64(length) {
+		return 0, false
+	}
+	return int(index), true
+}
+
+// DropPrefix advances only after the caller has authenticated the new suffix.
+// A failed advance leaves the old reference window unchanged for rollback.
+func (w *StableRequestWindow) DropPrefix(count int) bool {
+	if count < 0 || uint64(count) > uint64(math.MaxUint32)-uint64(w.base) {
+		return false
+	}
+	w.base += uint32(count)
+	return true
+}
+
+// Clear retires every current entry. An inconsistent length exhausts the
+// namespace rather than allowing an old reference to alias a future entry.
+func (w *StableRequestWindow) Clear(length int) {
+	if !w.DropPrefix(length) {
+		w.base = math.MaxUint32
+	}
+}
diff --git a/internal/parsercorephase0/stable_request_window_test.go b/internal/parsercorephase0/stable_request_window_test.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/stable_request_window_test.go
@@ -0,0 +1,91 @@
+package parsercorephase0
+
+import (
+	"math"
+	"testing"
+)
+
+func TestStableRequestWindowRetiresReferencesWithoutRenumbering(t *testing.T) {
+	var window StableRequestWindow
+	references := make([]uint32, 8)
+	for i := range references {
+		var ok bool
+		references[i], ok = window.Reference(i)
+		if !ok {
+			t.Fatal("initial reference failed")
+		}
+	}
+	if !window.DropPrefix(5) {
+		t.Fatal("prefix retirement failed")
+	}
+	for i, reference := range references {
+		index, ok := window.Index(reference, 3)
+		if i < 5 {
+			if ok {
+				t.Fatalf("retired reference %d resolves to %d", reference, index)
+			}
+		} else if !ok || index != i-5 {
+			t.Fatalf("surviving reference %d resolves to %d/%t", reference, index, ok)
+		}
+	}
+	next, ok := window.Reference(3)
+	if !ok || next != 9 {
+		t.Fatalf("next=%d/%t", next, ok)
+	}
+	window.Clear(3)
+	for _, reference := range references {
+		if _, ok := window.Index(reference, 1); ok {
+			t.Fatal("clear revived retired reference")
+		}
+	}
+	if next, ok := window.Reference(0); !ok || next != 9 {
+		t.Fatalf("reference after clear=%d/%t", next, ok)
+	}
+}
+
+func TestStableRequestWindowBoundsAndOverflow(t *testing.T) {
+	var window StableRequestWindow
+	if _, ok := window.Reference(-1); ok {
+		t.Fatal("accepted negative index")
+	}
+	if uint64(math.MaxInt) >= uint64(math.MaxUint32) {
+		if _, ok := window.Reference(math.MaxInt); ok {
+			t.Fatal("accepted index beyond the reference namespace")
+		}
+	}
+	for _, v := range []struct {
+		reference uint32
+		length    int
+	}{{0, 1}, {2, 1}, {1, -1}} {
+		if _, ok := window.Index(v.reference, v.length); ok {
+			t.Fatalf("accepted invalid lookup %+v", v)
+		}
+	}
+	if !window.DropPrefix(math.MaxInt32) || !window.DropPrefix(math.MaxInt32) {
+		t.Fatal("near-limit prefix failed")
+	}
+	last, ok := window.Reference(0)
+	if !ok || last != math.MaxUint32 {
+		t.Fatalf("last=%d/%t", last, ok)
+	}
+	before := window
+	if window.DropPrefix(2) || window.DropPrefix(-1) || window != before {
+		t.Fatal("failed advance changed window")
+	}
+	if _, ok := window.Reference(1); ok {
+		t.Fatal("reference wrapped")
+	}
+	if !window.DropPrefix(1) {
+		t.Fatal("last retirement failed")
+	}
+	if _, ok := window.Reference(0); ok {
+		t.Fatal("exhausted window issued reference")
+	}
+	if _, ok := window.Index(last, 1); ok {
+		t.Fatal("last retired reference revived")
+	}
+	window.Clear(-1)
+	if _, ok := window.Reference(0); ok {
+		t.Fatal("invalid clear revived namespace")
+	}
+}

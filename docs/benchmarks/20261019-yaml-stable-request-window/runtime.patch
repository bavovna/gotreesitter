+func TestDiagnosticParserCoreOwnedLexerStableRequestWindow(t *testing.T) {
+	newScheduler := func(t *testing.T) *diagnosticParserCoreGenericScheduler {
+		t.Helper()
+		compact, err := core.New(&genericConflictTable{}, core.Limits{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		language := &Language{Name: "stable-owned-request-window-test", LexModes: make([]LexMode, 3)}
+		scheduler := &diagnosticParserCoreGenericScheduler{
+			compact:       compact,
+			tokenSource:   &dfaTokenSource{lexer: NewLexer(nil, nil), language: language},
+			electionIndex: 7, versionLexerOwnershipActive: true,
+			versionLexerRequests: make([]diagnosticParserCoreVersionLexerRequest, 2),
+			receipt:              &DiagnosticParserCoreGenericScheduler{},
+		}
+		for state := 1; state <= 2; state++ {
+			head, err := compact.Seed(core.StateID(state), 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			snapshot := newDiagnosticParserCoreOwnedLexerSnapshot(t, compact, language, 0)
+			scheduler.headers = append(scheduler.headers, diagnosticParserCoreHeader{head: head, shifted: true, versionState: &diagnosticParserCoreVersionState{relexSnapshot: snapshot}})
+		}
+		return scheduler
+	}
+	t.Run("stable references and retired requests", func(t *testing.T) {
+		scheduler := newScheduler(t)
+		if err := scheduler.beginNextVersionLexerElection(); err != nil {
+			t.Fatal(err)
+		}
+		previous := append([]diagnosticParserCoreHeader(nil), scheduler.headers...)
+		previousValues := []diagnosticParserCoreVersionState{*previous[0].versionState, *previous[1].versionState}
+		for i := range scheduler.headers {
+			reference := scheduler.headers[i].versionLexerRequestReference()
+			if reference <= 2 || scheduler.versionLexerRequestForHeader(i) == nil || scheduler.versionLexerRequestReferenceForHeader(i) != reference {
+				t.Fatalf("header %d has invalid stable reference %d", i, reference)
+			}
+			scheduler.headers[i].shifted = true
+		}
+		if err := scheduler.beginNextVersionLexerElection(); err != nil {
+			t.Fatal(err)
+		}
+		for i, header := range previous {
+			if *header.versionState != previousValues[i] {
+				t.Fatal("new election mutated immutable rollback wrapper")
+			}
+			if _, ok := scheduler.versionLexerRequestWindow.Index(header.versionLexerRequestReference(), len(scheduler.versionLexerRequests)); ok {
+				t.Fatal("retired request still resolves")
+			}
+			if scheduler.versionLexerRequestForHeader(i) == nil {
+				t.Fatal("new request is not authenticated")
+			}
+		}
+	})
+	t.Run("partial election overflow rolls back", func(t *testing.T) {
+		scheduler := newScheduler(t)
+		if !scheduler.versionLexerRequestWindow.DropPrefix(math.MaxInt32-1) || !scheduler.versionLexerRequestWindow.DropPrefix(math.MaxInt32-1) {
+			t.Fatal("set near-limit window")
+		}
+		beforeHeaders := append([]diagnosticParserCoreHeader(nil), scheduler.headers...)
+		beforeWindow, beforeWork := scheduler.versionLexerRequestWindow, scheduler.work
+		err := scheduler.beginNextVersionLexerElection()
+		var decline *diagnosticParserCoreDecline
+		if !errors.As(err, &decline) || decline.boundary != DiagnosticParserCoreCap || !strings.Contains(decline.detail, "reference window exhausted") {
+			t.Fatalf("overflow error=%v", err)
+		}
+		if scheduler.versionLexerRequestWindow != beforeWindow || !reflect.DeepEqual(scheduler.headers, beforeHeaders) || scheduler.work != beforeWork || scheduler.electionIndex != 7 || len(scheduler.versionLexerRequests) != 2 || len(scheduler.receipt.VersionLexerRequests) != 0 {
+			t.Fatal("partial election overflow did not restore scheduler")
+		}
+	})
+}

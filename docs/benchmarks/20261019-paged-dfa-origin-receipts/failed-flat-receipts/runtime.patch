+// This prototype certifies identity only, never equality across distinct IDs.
+type prototypeDFATerminalSource struct {
+	priorityElection int
+	prioritySeen     bool
+	scheduler        *diagnosticParserCoreGenericScheduler
+	source           *dfaTokenSource
+	lexer            *Lexer
+	language         *Language
+	input            []byte
+	dispatch         Token
+	active           bool
+}

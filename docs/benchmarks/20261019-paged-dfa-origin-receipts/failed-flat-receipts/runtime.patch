diff --git a/internal/parsercorephase0/dfa_terminal_identity.go b/internal/parsercorephase0/dfa_terminal_identity.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/dfa_terminal_identity.go
@@ -0,0 +1,110 @@
+package parsercorephase0
+
+import (
+	"errors"
+	"unsafe"
+)
+
+// SharedDFATerminalSource authenticates the complete token elected by the
+// adapter's actual internal DFA source. An owner-scoped dispatch must be
+// active; matching scalar token values alone must never return true.
+type SharedDFATerminalSource interface {
+	SharedDFATerminalOrigin(Token) uint32
+}
+
+// Receipt origins are issued by one actual elected DFA read, not derived
+// from token values, lexer-mode equality or a hash. The source is fixed by the
+// fresh owner; its sequence cannot cross owner or reset generations.
+type dfaTerminalOriginReceipt struct {
+	payload SubtreeID
+	origin  uint32
+}
+
+type freshDFATerminalIdentity struct {
+	source     SharedDFATerminalSource
+	owner      SchedulerTransactionToken
+	generation uint64
+	certified  []dfaTerminalOriginReceipt
+}
+
+// BindFreshDFATerminalSourceOwned binds one source to this fresh owner and
+// reset generation, before any payload exists. No transaction, nested binding
+// or later source replacement can issue receipts for existing payloads.
+func (c *Core) BindFreshDFATerminalSourceOwned(owner SchedulerTransactionToken, source SharedDFATerminalSource) (err error) {
+	if err = c.beginSchedulerOwned(owner); err != nil {
+		return err
+	}
+	defer c.recoverSchedulerOwnedPanic(owner)
+	if !c.schedulerFrame.fresh || source == nil || len(c.subtrees) != 0 || c.freshDFATerminalIdentityActive() {
+		return c.finishSchedulerOwned(owner, errors.New("parser-core phase zero: DFA identity source requires one empty fresh session"))
+	}
+	if c.dfaTerminalIdentity == nil {
+		c.dfaTerminalIdentity = new(freshDFATerminalIdentity)
+	}
+	state := c.dfaTerminalIdentity
+	clear(state.certified)
+	state.certified = state.certified[:0]
+	state.source, state.owner, state.generation = source, owner, c.resetGeneration
+	return c.finishSchedulerOwned(owner, nil)
+}
+
+func (c *Core) freshDFATerminalIdentityActive() bool {
+	state := c.dfaTerminalIdentity
+	return state != nil && state.source != nil && c.schedulerFrame.active && c.schedulerFrame.fresh &&
+		state.owner.owner == c && state.owner.epoch == c.schedulerFrame.epoch &&
+		state.owner.transaction == c.schedulerFrame.mark.transaction && state.generation == c.resetGeneration
+}
+
+func (c *Core) clearFreshDFATerminalIdentity() {
+	if state := c.dfaTerminalIdentity; state != nil {
+		state.source = nil
+		state.owner = SchedulerTransactionToken{}
+		state.generation = 0
+		clear(state.certified)
+		state.certified = state.certified[:0]
+	}
+}
+
+func (c *Core) recordFreshDFATerminalIdentity(id SubtreeID, record subtreeRecord, prefix uint16) {
+	if !c.freshDFATerminalIdentityActive() || record.external || record.missing || record.symbol == 0 || record.symbol >= ErrorRegionSymbol-1 {
+		return
+	}
+	token := Token{Symbol: record.symbol, StartByte: record.startByte, EndByte: record.endByte, Extra: record.extra, LexerSkippedPrefixLength: prefix}
+	state := c.dfaTerminalIdentity
+	origin := state.source.SharedDFATerminalOrigin(token)
+	if origin == 0 {
+		return
+	}
+	state.certified = append(state.certified, dfaTerminalOriginReceipt{payload: id, origin: origin})
+}
+
+func (c *Core) freshDFATerminalOrigin(id SubtreeID) uint32 {
+	if id == 0 || !c.freshDFATerminalIdentityActive() {
+		return 0
+	}
+	rows := c.dfaTerminalIdentity.certified
+	low, high := 0, len(rows)
+	for low < high {
+		mid := low + (high-low)/2
+		if rows[mid].payload < id {
+			low = mid + 1
+		} else {
+			high = mid
+		}
+	}
+	if low == len(rows) || rows[low].payload != id {
+		return 0
+	}
+	return rows[low].origin
+}
+
+func (c *Core) freshDFATerminalIdentityExact(id SubtreeID) bool {
+	return c.freshDFATerminalOrigin(id) != 0
+}
+
+func (c *Core) freshDFATerminalIdentityFootprintBytes() uint64 {
+	if c.dfaTerminalIdentity == nil {
+		return 0
+	}
+	return uint64(unsafe.Sizeof(*c.dfaTerminalIdentity)) + uint64(cap(c.dfaTerminalIdentity.certified))*8
+}
diff --git a/internal/parsercorephase0/dfa_terminal_identity_test.go b/internal/parsercorephase0/dfa_terminal_identity_test.go
new file mode 100644
--- /dev/null
+++ b/internal/parsercorephase0/dfa_terminal_identity_test.go
@@ -0,0 +1,255 @@
+package parsercorephase0
+
+import (
+	"errors"
+	"testing"
+)
+
+type testSharedDFASource struct {
+	allow  bool
+	origin uint32
+}
+
+func (s *testSharedDFASource) AuthenticatesSharedDFATerminal(tok Token) bool {
+	return s.allow && tok.Symbol == 3 && tok.StartByte == 0 && tok.EndByte == 1 && !tok.External
+}
+
+func (s *testSharedDFASource) SharedDFATerminalOrigin(tok Token) uint32 {
+	if !s.AuthenticatesSharedDFATerminal(tok) {
+		return 0
+	}
+	if s.origin != 0 {
+		return s.origin
+	}
+	return 1
+}
+
+func TestFreshDFATerminalIdentitySelectionAndScope(t *testing.T) {
+	c := newCSelectionCompareTestCore(t)
+	source := &testSharedDFASource{allow: true}
+	var leaf SubtreeID
+	err := c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		if err := c.BindFreshDFATerminalSourceOwned(owner, source); err != nil {
+			return err
+		}
+		var err error
+		leaf, err = c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0)
+		if err != nil {
+			return err
+		}
+		if !c.freshDFATerminalIdentityExact(leaf) {
+			t.Fatal("actual source terminal was not certified")
+		}
+		left, right := reductionSelectionPair(t, c, leaf, leaf)
+		cmp, selected, err := c.compareReconvergedReductionChildren(left, right)
+		if err != nil || !selected || cmp != 1 {
+			t.Fatalf("selection %d %t %v", cmp, selected, err)
+		}
+		if c.freshDFATerminalIdentityFootprintBytes() == 0 {
+			t.Fatal("receipt capacity is not budgeted")
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.freshDFATerminalIdentityExact(leaf) || c.dfaTerminalIdentity.source != nil {
+		t.Fatal("source or receipt escaped its owner")
+	}
+	if err := c.Reset(); err != nil {
+		t.Fatal(err)
+	}
+	if c.freshDFATerminalIdentityExact(leaf) {
+		t.Fatal("receipt survived reset")
+	}
+}
+
+func TestFreshDFATerminalIdentityRejectsUnprovenOrDifferentOrigins(t *testing.T) {
+	for _, allow := range []bool{false, true} {
+		c := newCSelectionCompareTestCore(t)
+		source := &testSharedDFASource{allow: allow}
+		err := c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+			if err := c.BindFreshDFATerminalSourceOwned(owner, source); err != nil {
+				return err
+			}
+			a, e := c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0)
+			if e != nil {
+				return e
+			}
+			source.origin = 2
+			b, e := c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0)
+			if e != nil {
+				return e
+			}
+			left, right := reductionSelectionPair(t, c, a, b)
+			if _, selected, e := c.compareReconvergedReductionChildren(left, right); e != nil || selected {
+				t.Fatalf("allow %t: different identities selected: %t %v", allow, selected, e)
+			}
+			if !allow {
+				left, right = reductionSelectionPair(t, c, a, a)
+				if _, selected, e := c.compareReconvergedReductionChildren(left, right); e != nil || selected {
+					t.Fatal("unproven identical IDs selected")
+				}
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestFreshDFATerminalIdentityRejectsRebindingAndReleasesOnFailure(t *testing.T) {
+	c := newCSelectionCompareTestCore(t)
+	source := &testSharedDFASource{allow: true}
+	err := c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		if e := c.BindFreshDFATerminalSourceOwned(owner, source); e != nil {
+			return e
+		}
+		if e := c.BindFreshDFATerminalSourceOwned(owner, source); e == nil {
+			t.Fatal("source replacement succeeded")
+		}
+		return nil
+	})
+	if err == nil {
+		t.Fatal("ignored source-binding failure did not poison session")
+	}
+	if c.dfaTerminalIdentity != nil {
+		t.Fatal("failed source retained capacity")
+	}
+	sentinel := errors.New("stop")
+	err = c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		if e := c.BindFreshDFATerminalSourceOwned(owner, source); e != nil {
+			return e
+		}
+		_, e := c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0)
+		if e != nil {
+			return e
+		}
+		return sentinel
+	})
+	if !errors.Is(err, sentinel) || c.dfaTerminalIdentity != nil {
+		t.Fatal("failed parse retained a source or proof")
+	}
+}
+
+func TestFreshDFATerminalIdentityDoesNotCertifyGenericPublication(t *testing.T) {
+	c := newCSelectionCompareTestCore(t)
+	if err := c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		if err := c.BindFreshDFATerminalSourceOwned(owner, &testSharedDFASource{allow: true}); err != nil {
+			return err
+		}
+		leaf, err := c.appendSubtree(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, nil, nil, nil)
+		if err != nil {
+			return err
+		}
+		if c.freshDFATerminalIdentityExact(leaf) {
+			t.Fatal("generic record inherited an elected-token receipt")
+		}
+		left, right := reductionSelectionPair(t, c, leaf, leaf)
+		if _, selected, err := c.compareReconvergedReductionChildren(left, right); err != nil || selected {
+			t.Fatal("generic publication authorized child selection")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestFreshDFATerminalIdentityRejectsLateOrTransactionalBinding(t *testing.T) {
+	for _, kind := range []string{"late", "transaction"} {
+		c := newCSelectionCompareTestCore(t)
+		run := c.RunFreshSchedulerSession
+		if kind == "transaction" {
+			run = c.ApplySchedulerAtomic
+		}
+		err := run(func(owner SchedulerTransactionToken) error {
+			if kind == "late" {
+				if _, e := c.appendSubtree(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, nil, nil, nil); e != nil {
+					return e
+				}
+			}
+			if e := c.BindFreshDFATerminalSourceOwned(owner, &testSharedDFASource{allow: true}); e == nil {
+				t.Fatalf("%s binding succeeded", kind)
+			}
+			return nil
+		})
+		if err == nil {
+			t.Fatalf("%s ignored failure did not poison its owner", kind)
+		}
+	}
+}
+
+func TestFreshDFATerminalIdentityRejectsForeignOwner(t *testing.T) {
+	a, b := newCSelectionCompareTestCore(t), newCSelectionCompareTestCore(t)
+	if err := a.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		inner := b.RunFreshSchedulerSession(func(SchedulerTransactionToken) error {
+			if err := b.BindFreshDFATerminalSourceOwned(owner, &testSharedDFASource{allow: true}); err == nil {
+				t.Fatal("foreign owner issued a source")
+			}
+			return nil
+		})
+		if inner == nil {
+			t.Fatal("foreign owner did not poison receiver")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestFreshDFATerminalIdentityPanicClearsSource(t *testing.T) {
+	c := newCSelectionCompareTestCore(t)
+	sentinel := errors.New("panic")
+	func() {
+		defer func() {
+			if recover() != sentinel {
+				t.Fatal("panic contract changed")
+			}
+		}()
+		_ = c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+			if err := c.BindFreshDFATerminalSourceOwned(owner, &testSharedDFASource{allow: true}); err != nil {
+				return err
+			}
+			if _, err := c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0); err != nil {
+				return err
+			}
+			panic(sentinel)
+		})
+	}()
+	if c.dfaTerminalIdentity != nil {
+		t.Fatal("panicked owner retained source capacity")
+	}
+}
+
+func TestFreshDFATerminalOriginSameElectionDifferentPayloads(t *testing.T) {
+	c := newCSelectionCompareTestCore(t)
+	source := &testSharedDFASource{allow: true, origin: 7}
+	if err := c.RunFreshSchedulerSession(func(owner SchedulerTransactionToken) error {
+		if err := c.BindFreshDFATerminalSourceOwned(owner, source); err != nil {
+			return err
+		}
+		a, err := c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0)
+		if err != nil {
+			return err
+		}
+		b, err := c.appendAuthenticatedTerminal(subtreeRecord{terminal: true, symbol: 3, endByte: 1}, 0)
+		if err != nil {
+			return err
+		}
+		if a == b || c.freshDFATerminalOrigin(a) != 7 || c.freshDFATerminalOrigin(b) != 7 {
+			t.Fatal("actual origin identity was lost")
+		}
+		left, right := reductionSelectionPair(t, c, a, b)
+		if cmp, selected, err := c.compareReconvergedReductionChildren(left, right); err != nil || !selected || cmp != 1 {
+			t.Fatalf("same election selection %d %t %v", cmp, selected, err)
+		}
+		c.subtrees[b-1].extra = true
+		if _, selected, err := c.compareReconvergedReductionChildren(left, right); err != nil || selected {
+			t.Fatal("origin equality bypassed scalar leaf comparison")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}

+func (s *diagnosticParserCoreGenericScheduler) bindPrototypeDFATerminalIdentity(owner core.SchedulerTransactionToken) error {
+	if s.tokenSource == nil || s.tokenSource.lexer == nil || s.tokenSource.language == nil || classifyExternalScannerQuiescence(s.tokenSource.language) != scannerQuiescenceProven || len(s.tokenSource.lexer.source) == 0 {
+		return nil
+	}
+	s.dfaIdentitySource = prototypeDFATerminalSource{scheduler: s, source: s.tokenSource, lexer: s.tokenSource.lexer, language: s.tokenSource.language, input: s.tokenSource.lexer.source}
+	return s.compact.BindFreshDFATerminalSourceOwned(owner, &s.dfaIdentitySource)
+}
+func (s *diagnosticParserCoreGenericScheduler) clearPrototypeDFATerminalIdentity() {
+	s.dfaIdentitySource = prototypeDFATerminalSource{}
+}
+func (s *diagnosticParserCoreGenericScheduler) beginPrototypeDFADispatch(tok Token, shared bool) (Token, bool) {
+	proof := &s.dfaIdentitySource
+	beforeToken, beforeActive := proof.dispatch, proof.active
+	proof.dispatch, proof.active = tok, shared && proof.scheduler == s && tok == s.token && tok == s.currentElection.Token &&
+		tok.lexerInternalDFALexed() && !tok.ExternalScannerToken && !tok.Missing && !tok.NoLookahead && tok.Symbol != 0 &&
+		tok.lexFlags&(tokenFlagErrorModeLexed|tokenFlagErrorModeRetried) == 0
+	return beforeToken, beforeActive
+}
+func (p *prototypeDFATerminalSource) AuthenticatesSharedDFATerminal(tok core.Token) bool {
+	s := p.scheduler
+	if s == nil || !p.active || s.freshSessionOwner == nil || s.tokenSource != p.source || p.source.lexer != p.lexer || p.source.language != p.language || classifyExternalScannerQuiescence(p.language) != scannerQuiescenceProven {
+		return false
+	}
+	current := p.lexer.source
+	if len(current) != len(p.input) || len(current) == 0 || &current[0] != &p.input[0] || p.dispatch != s.token || p.dispatch != s.currentElection.Token {
+		return false
+	}
+	root := p.dispatch
+	return !tok.External && tok.Symbol == core.Symbol(root.Symbol) && tok.StartByte == root.StartByte && tok.EndByte == root.EndByte &&
+		root.EndByte <= uint32(len(current)) && root.lexerLookaheadEndByte <= uint32(len(current))+1 &&
+		tok.LexerSkippedPrefixLength == diagnosticParserCoreLexerSkippedPrefixLength(root, s.options.captureLexerSkippedPrefixProvenance)
+}
+
+func (p *prototypeDFATerminalSource) SharedDFATerminalOrigin(tok core.Token) uint32 {
+	if !p.AuthenticatesSharedDFATerminal(tok) || p.scheduler.electionIndex <= 0 || uint64(p.scheduler.electionIndex) > math.MaxUint32 {
+		return 0
+	}
+	return uint32(p.scheduler.electionIndex)
+}
+
+func (s *diagnosticParserCoreGenericScheduler) endPrototypeDFADispatch(before Token, active bool) {
+	s.dfaIdentitySource.dispatch, s.dfaIdentitySource.active = before, active
+}
